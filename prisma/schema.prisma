// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// role: "ADMIN" | "STUDENT"
model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         String   @default("STUDENT")
  createdAt    DateTime @default(now())

  assignments      ProgramAssignment[]
  sentMessages     Message[]           @relation("MessageSender")
  receivedMessages Message[]           @relation("MessageReceiver")
}

model Program {
  id            String   @id @default(cuid())
  title         String
  description   String
  level         String
  durationWeeks Int
  content       String
  coverImage    String?
  createdAt     DateTime @default(now())

  assignments ProgramAssignment[]
}

model ProgramAssignment {
  id         String   @id @default(cuid())
  userId     String
  programId  String
  assignedAt DateTime @default(now())
  notes      String?

  user    User    @relation(fields: [userId], references: [id])
  program Program @relation(fields: [programId], references: [id])
}

// type: "IMAGE" | "VIDEO"
model GalleryItem {
  id        String   @id @default(cuid())
  type      String   @default("IMAGE")
  url       String?
  caption   String
  takenAt   DateTime @default(now())
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

// type: "REEL" | "POST" — mirrors the /reel/ vs /p/ segment of the Instagram permalink
// The permalink is derived from `shortcode` + `type` in src/lib/instagram.ts rather than stored.
model InstagramPost {
  id        String   @id @default(cuid())
  shortcode String   @unique
  type      String   @default("REEL")
  thumbnail String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Submitted from the public site via src/lib/actions/submit-testimonial.ts with
// approved = false, then flipped to true by an admin. `phone` is collected so the coach
// can verify the submitter; it is admin-only and must never be selected into public
// queries.
model Testimonial {
  id           String   @id @default(cuid())
  studentName  String
  studentImage String?
  rating       Int      @default(5)
  content      String
  phone        String?
  approved     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// type: "ONLINE" | "IN_PERSON"
// features stored as a JSON-encoded string array (SQLite has no scalar lists)
//
// `priceToman` is in whole toman — the unit is in the name because the admin panel lets
// the coach edit it directly, and a column that silently meant "thousands of toman"
// turned every price edit into a factor-of-1000 guess. Convert to rial for an order
// only via the helpers in src/lib/orders.ts.
model Package {
  id           String   @id @default(cuid())
  title        String
  description  String
  priceToman   Int
  periodLabel  String
  features     String
  type         String   @default("ONLINE")
  highlighted  Boolean  @default(false)
  createdAt    DateTime @default(now())

  orders Order[]
}

// A payment link (an invoice) the coach issues by hand from the admin panel.
//
// Deliberately NOT tied to a User: buying a plan requires neither an account nor the
// consultation form. The coach talks to the person first (usually on WhatsApp), then
// issues a link; the `token` is the only thing authorising the checkout, which is why
// it's random rather than a cuid, and why the link expires. Allowed values for the
// enum-like String columns are the single source of truth in src/lib/orders.ts.
//
// status: "PENDING" | "PAID" | "CANCELED"
//
// `amountRial` is in RIAL, unlike `Package.price` which is in thousands of toman —
// convert only via the helpers in src/lib/orders.ts.
//
// `customerPhone` is admin-only contact data; never select it into a public query.
// The public /pay/[token] page is an exception and shows only what the payer typed.
model Order {
  id            String    @id @default(cuid())
  token         String    @unique
  packageId     String
  customerName  String
  customerPhone String
  amountRial    Int
  status        String    @default("PENDING")
  note          String?
  expiresAt     DateTime?
  paidAt        DateTime?
  // Filled in by the payment gateway once one is connected. Named generically so
  // swapping ZarinPal for another PSP doesn't need a migration.
  gateway          String?
  gatewayAuthority String?
  gatewayRefId     String?
  createdAt     DateTime  @default(now())

  package Package @relation(fields: [packageId], references: [id])
}

// Consultation request submitted from the public multi-step form
// (src/lib/actions/submit-lead.ts). Allowed values for the enum-like String columns are
// the single source of truth in src/lib/consultation.ts.
//
// goal:             "FAT_LOSS" | "MUSCLE_GAIN" | "GENERAL_FITNESS" | "COMPETITION"
// level:            "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
// mode:             "online" | "in-person" | "not-sure"
// preferredChannel: "whatsapp" | "telegram" | "call"
// status:           "NEW" | "CONTACTED" | "CLOSED"
//
// `phone`, `telegramUsername` and `injuryNote` are admin-only. `injuryNote` is health
// information — never select it into a public query.
model Lead {
  id               String   @id @default(cuid())
  name             String
  phone            String
  telegramUsername String?
  preferredChannel String   @default("whatsapp")
  goal             String   @default("GENERAL_FITNESS")
  level            String   @default("BEGINNER")
  mode             String   @default("online")
  daysPerWeek      Int      @default(3)
  hasInjury        Boolean  @default(false)
  injuryNote       String?
  message          String?
  status           String   @default("NEW")
  createdAt        DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("MessageSender", fields: [senderId], references: [id])
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id])
}

// Single-row table (id is always ABOUT_CONTENT_ID) holding the editable copy and photo
// of the "درباره من" section, so the coach can rewrite it from /admin/about without a
// deploy. Defaults live in src/lib/about.ts and are used whenever the row is missing,
// so a fresh database still renders a complete page.
//
// `bodyText` holds the /about page's paragraphs separated by blank lines — SQLite has no
// scalar lists, and a textarea is the natural editor for prose anyway.
model AboutContent {
  id          String   @id @default("about")
  eyebrow     String
  heading     String
  previewText String
  bodyText    String
  image       String?
  updatedAt   DateTime @updatedAt
}

// One row per public page view, recorded first-party by the /px tracking pixel
// (src/app/px/route.ts). Self-hosted on purpose: hosted analytics (Google Analytics,
// Plausible Cloud, …) are either blocked from Iran or block Iranian traffic, so their
// script would simply not load for most of this site's audience.
//
// No IP address is ever stored. `visitorHash` is a keyed hash of IP + User-Agent that is
// re-salted every calendar month (see src/lib/analytics.ts), which is what makes
// COUNT(DISTINCT visitorHash) a correct "how many people" figure for both a day inside
// that month and the month as a whole.
//
// `day` ("YYYY-MM-DD") and `month` ("YYYY-MM") are stored as strings in Tehran local
// time. SQLite's own date functions are UTC-only, so grouping on createdAt would put
// the +03:30 evening traffic on the wrong day.
model PageView {
  id          String   @id @default(cuid())
  path        String
  visitorHash String
  day         String
  month       String
  createdAt   DateTime @default(now())

  @@index([day, visitorHash])
  @@index([month, visitorHash])
  @@index([createdAt])
}
